# 未設 APP_ENV = production（fail closed）：缺機密或 <32 字元會拒絕啟動。本機開發請明確設 dev。
APP_ENV=dev
DATABASE_URL=postgres://wishsync:wishsync@localhost:5432/wishsync
# 預設 127.0.0.1:8080。容器內部署需明確設 BIND=0.0.0.0:8080（並只讓 Cloudflare Tunnel / 內網可達）
BIND=127.0.0.1:8080
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080
# --- 機密：下列 dev 值僅供本機；production 必須各自獨立、>=32 字元隨機值（openssl rand -hex 32） ---
OTP_PEPPER=dev-pepper
OAUTH_SECRET=dev-oauth-secret
UNSUB_SECRET=dev-unsub-secret
# --- 寄信 ---
# dev：SMTP -> Mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=noreply@wishsync.tw
# production：Cloudflare Email Service（三者皆必填；MAIL_FROM 須為已驗證網域）
# CF_ACCOUNT_ID=
# CF_EMAIL_API_TOKEN=
# 反向代理：none（用 socket 位址）| cloudflare（信任 CF-Connecting-IP）
# dev 預設 none；production 必須明確設定（不設會讓所有使用者看起來來自同一 IP，每 IP 限流變全域）
# 設 cloudflare 時 API 只能經 Cloudflare Tunnel 存取，否則 CF-Connecting-IP 可被偽造（BIND 非回送位址會印 WARN）
# TRUSTED_PROXY=cloudflare
# --- Turnstile（檢舉）：production 必填；dev 不設則略過驗證（接受任何 token，含前端 dev-bypass） ---
# TURNSTILE_SECRET=
# TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify   # 僅測試 / mock 時覆寫
# --- S3 / R2：production 必填 ENDPOINT、BUCKET、ACCESS_KEY、SECRET_KEY、PUBLIC_BASE；dev 預設為本機 MinIO ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=wishsync-media
S3_ACCESS_KEY=wishsync
S3_SECRET_KEY=wishsync-secret
S3_REGION=auto
S3_PUBLIC_BASE=http://localhost:9000/wishsync-media
# --- 收件資訊加密金鑰：production 必填（base64 的 32 bytes，openssl rand -base64 32）；dev 不設用固定開發金鑰 ---
# 遺失或更換 = 已存地址全部無法解密，務必備份；目前沒有輪替機制，見 README〈收件資訊加密金鑰〉
# SHIPPING_ENC_KEY=
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/line/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/google/callback
# 以下僅測試 / mock 時覆寫
# GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
# GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
# GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
# GOOGLE_ISSUER=
